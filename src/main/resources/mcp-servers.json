{
  "mcpServers": {
    "amap-maps": {
      "command": "npx.cmd",
      "args": ["-y", "@amap/amap-maps-mcp-server"],
      "env": {
        "AMAP_MAPS_API_KEY": "REPLACE_WITH_AMAP_MAPS_API_KEY"
      }
    },
    "guo-image-search-mcp-server": {
      "command": "java",
      "args": [
        "-Dspring.profiles.active=stdio",
        "-jar",
        "guo-image-search-mcp-server/target/guo-image-search-mcp-server-0.0.1-SNAPSHOT.jar"
      ],
      "env": {
        "PEXELS_API_KEY": "REPLACE_WITH_PEXELS_API_KEY"
      }
    }
  }
}
